<% content_for :title, "#{@repository.display_name} · Fortop" %><% content_for :breadcrumb, @repository.display_name %>
<%= link_to repositories_path, class: "back-link" do %><%= app_icon(:back) %> Repositorios<% end %>
<div class="repository-heading"><span class="repository-glyph large"><%= app_icon(:repository) %></span><div><span class="eyebrow"><%= @repository.full_name.split('/').first %></span><h1><%= @repository.display_name %></h1></div><%= external_link(safe_join([app_icon(:github), "Ver en GitHub", app_icon(:external)]), @repository.html_url, class: "button button-secondary") %></div>
<% if @repository.description.present? %><p class="profile-description"><%= @repository.description %></p><% end %>
<div class="repository-profile-meta"><span><%= app_icon(:branch) %><%= @repository.default_branch %></span><% if @repository.language.present? %><span><%= app_icon(:code) %><%= @repository.language %></span><% end %><span><%= app_icon(@repository.private? ? :lock : :globe) %><%= @repository.private? ? 'Privado' : 'Público' %></span></div>
<section class="run-panel panel"><div class="run-panel-copy"><span class="eyebrow">AGENTES EN ACCIÓN</span><h2>Del diagnóstico<br>a la propuesta de mejora.</h2><p>Un agente analiza el código y reúne evidencias. Otro prepara las correcciones. Fortop verifica los cambios y los propone en GitHub.</p><% if @latest_scan&.active? %><%= link_to repository_scan_path(@repository, @latest_scan), class: "button button-primary" do %><span class="button-spinner"></span> Ver análisis en curso <%= app_icon(:arrow) %><% end %><% else %><%= button_to repository_scans_path(@repository), class: "button button-primary", data: { turbo_submits_with: "Preparando agentes…" } do %><%= app_icon(:sparkles) %> Iniciar análisis y remediación <%= app_icon(:arrow) %><% end %><% end %><span class="run-panel-note">Los cambios se proponen en una rama para tu revisión.</span></div><div class="run-flow" aria-label="Fases del proceso"><div><span>01</span><section><h3>Investigar</h3><p>Código, arquitectura y señales SEO/GEO.</p></section><%= app_icon(:search) %></div><div><span>02</span><section><h3>Remediar</h3><p>Correcciones guiadas por los hallazgos.</p></section><%= app_icon(:code) %></div><div><span>03</span><section><h3>Verificar y proponer</h3><p>Comprobaciones, issues y pull request.</p></section><%= app_icon(:pull_request) %></div></div></section>
<div class="section-heading"><div><span class="eyebrow">EL CAMINO RECORRIDO</span><h2>Historial de análisis</h2></div><span><%= @scans.count %> <%= @scans.count == 1 ? 'ejecución' : 'ejecuciones' %></span></div>
<section class="panel history-panel"><% if @scans.empty? %><div class="history-empty"><%= app_icon(:clock) %><div><strong>El primer análisis está por llegar.</strong><p>Cuando ejecutes tus agentes, encontrarás aquí su progreso y sus resultados.</p></div></div><% else %><div class="history-table"><div class="history-header"><span>EJECUCIÓN</span><span>ESTADO</span><span>HALLAZGOS</span><span></span></div><% @scans.each do |scan| %><%= link_to repository_scan_path(@repository, scan), class: "history-row" do %><div><strong>Análisis #<%= scan.id %></strong><span><%= human_timestamp(scan.created_at) %></span></div><%= status_badge(scan) %><span class="history-count"><%= scan.findings.count %></span><%= app_icon(:arrow) %><% end %><% end %></div><% end %></section>
<div class="disconnect-row"><span>Conectado el <%= @repository.connected_at.in_time_zone('Europe/Madrid').strftime('%d/%m/%Y') %></span><%= button_to "Desconectar repositorio", repository_path(@repository), method: :delete, class: "text-link muted-link", disabled: @latest_scan&.active?, data: { turbo_confirm: "¿Desconectar #{@repository.full_name}? Se eliminará su historial en Fortop." } %></div>
