# Local credentials and environment overrides; examples stay versioned.
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/config/credentials/*.key

# Editor state, local dependencies and generated working files.
**/.ruby-lsp/
**/.bundle/
**/node_modules/
**/__pycache__/
**/*.pyc
/.vscode/
/.idea/
/.DS_Store
**/.DS_Store
/tmp/

# Packaged copies of versioned deliverables can be regenerated.
/fortop-deliverables/fortop-entregables.zip

# Referencias de otros proyectos: se conservan solo en el equipo local.
/fortop_pitch/ejemplos-otros-pitches/
