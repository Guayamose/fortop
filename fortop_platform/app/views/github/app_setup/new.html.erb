<% content_for :title, "Conectar GitHub · Fortop" %>
<div class="access-shell">
  <section class="access-side">
    <header class="access-top"><%= image_tag "brand/fortop-dark.svg", alt: "FORTOP", class: "access-logo", width: 164, height: 43 %><span class="access-top-label">Configuración inicial</span></header>
    <div class="access-card">
      <span class="eyebrow">UNA CONEXIÓN. TODO PREPARADO.</span>
      <h1>Conecta Fortop<br>con GitHub.</h1>
      <p class="access-description">Registra la aplicación en tu cuenta de GitHub. Los permisos y la conexión con Fortop se configuran automáticamente.</p>
      <div class="access-login">
        <%= form_with url: @registration_url, method: :post, local: true, authenticity_token: false, data: { turbo: false } do %>
          <%= hidden_field_tag :manifest, @manifest %>
          <%= button_tag type: "submit", class: "button button-primary button-full" do %><%= app_icon(:github) %> Registrar GitHub App <%= app_icon(:external) %><% end %>
        <% end %>
        <p class="form-note">GitHub te pedirá confirmar el registro. Este paso solo se realiza una vez.</p>
      </div>
      <div class="access-steps">
        <div><span>01</span><p>Confirma el registro en GitHub</p><%= app_icon(:github) %></div>
        <div><span>02</span><p>Vuelve a Fortop e inicia sesión</p><%= app_icon(:check) %></div>
        <div><span>03</span><p>Elige los repositorios que quieras conectar</p><%= app_icon(:repository) %></div>
      </div>
      <%= link_to new_session_path, class: "back-link setup-back-link" do %><%= app_icon(:back) %> Volver al acceso<% end %>
    </div>
    <footer class="access-footer"><span>© <%= Time.current.year %> Fortop</span><span>SEO / GEO</span><span class="access-language">ES</span></footer>
  </section>
  <%= render "shared/access_art", caption: "Tu código. Tus agentes. Cada mejora, bajo tu control." %>
</div>
