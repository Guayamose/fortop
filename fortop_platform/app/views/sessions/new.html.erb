<% content_for :title, "Acceder · Fortop" %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<div class="access-shell">
  <section class="access-side">
    <header class="access-top">
      <%= image_tag "brand/fortop-dark.svg", alt: "FORTOP", class: "access-logo", width: 164, height: 43 %>
      <span class="access-top-label">Análisis y remediación</span>
    </header>
    <div class="access-card">
      <span class="eyebrow">TU CÓDIGO. TU PRÓXIMO PASO.</span>
      <h1>Todo empieza<br>en tu repositorio.</h1>
      <p class="access-description">Encuentra qué mejorar. Deja que tus agentes preparen los cambios. Revisa cada propuesta en GitHub.</p>
      <div class="access-login">
        <% if Github::App.configured? %>
          <%= button_to session_path, class: "button button-primary button-full", form: { data: { turbo: false } } do %><%= app_icon(:github) %> Continuar con GitHub <%= app_icon(:arrow) %><% end %>
          <p class="form-note">Conecta tu cuenta para entrar en tu espacio de trabajo.</p>
        <% elsif Rails.env.development? && request.local? %>
          <%= link_to github_setup_path, class: "button button-primary button-full" do %><%= app_icon(:github) %> Conectar Fortop con GitHub <%= app_icon(:arrow) %><% end %>
          <p class="form-note">Registra la aplicación en GitHub para activar el acceso.</p>
        <% else %>
          <div class="flash flash-alert" role="status"><%= app_icon(:clock) %><span>El acceso con GitHub estará disponible en cuanto se complete la configuración de la plataforma.</span></div>
        <% end %>
      </div>
      <div class="access-steps" aria-label="Cómo funciona Fortop">
        <div><span>01</span><p>Conecta tu repositorio</p><%= app_icon(:repository) %></div>
        <div><span>02</span><p>Inicia el análisis y la remediación</p><%= app_icon(:sparkles) %></div>
        <div><span>03</span><p>Revisa los issues y pull requests</p><%= app_icon(:pull_request) %></div>
      </div>
      <p class="access-footnote"><%= app_icon(:lock) %> Tú eliges los repositorios. Cada cambio queda pendiente de tu revisión.</p>
    </div>
    <footer class="access-footer"><span>© <%= Time.current.year %> Fortop</span><span>SEO / GEO</span><span class="access-language">ES</span></footer>
  </section>
  <%= render "shared/access_art", caption: "Del hallazgo al cambio. Con evidencia y bajo tu control." %>
</div>
