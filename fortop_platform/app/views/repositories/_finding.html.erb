<details class="finding-review" id="finding-<%= finding.id %>">
  <summary class="finding-review-summary">
    <span class="severity-mark severity-<%= finding.severity %>" aria-hidden="true"></span>
    <div class="finding-review-title">
      <strong><%= finding.title %></strong>
      <span><%= finding_category(finding) %><% if finding.file_path.present? %><span class="finding-meta-separator">·</span><code><%= finding.file_path %><%= ":#{finding.line_number}" if finding.line_number %></code><% end %></span>
    </div>
    <span class="finding-review-status"><%= finding_status_label(finding.status) %></span>
    <span class="finding-priority finding-priority-<%= finding.severity %>"><%= severity_label(finding.severity) %></span>
    <%= app_icon(:chevron_down, css_class: "finding-review-toggle") %>
  </summary>
  <div class="finding-review-body">
    <div class="finding-explanation">
      <section><h4>Qué hemos encontrado</h4><%= simple_format(h(finding.description), class: "finding-copy", sanitize: false) %></section>
      <% if finding.impact.present? %><section><h4>Por qué importa</h4><%= simple_format(h(finding.impact), class: "finding-copy", sanitize: false) %></section><% end %>
    </div>

    <section class="finding-evidence" aria-label="Evidencia del código">
      <div class="finding-section-heading"><h4>Evidencia</h4><span>Código original<% if finding.scan.base_sha.present? %> · <code><%= finding.scan.base_sha.first(7) %></code><% end %></span></div>
      <div class="finding-code-frame">
        <header><span><%= app_icon(:file) %><%= finding.file_path.presence || "Fragmento observado" %></span><span><%= finding_lexer(finding.evidence, finding.file_path).title %><% if (url = finding_source_url(finding)) %><%= external_link(safe_join(["Ver origen", app_icon(:external)]), url, class: "text-link") %><% end %></span></header>
        <div class="finding-code-scroll" tabindex="0" role="region" aria-label="Código de evidencia">
          <pre class="finding-source"><code><% highlighted_evidence(finding).each_with_index do |line, index| %><span class="finding-source-line"><span class="finding-line-number" aria-hidden="true"><%= (finding.line_number || 1) + index %></span><span class="finding-source-text syntax-highlight"><%= line %></span></span><% end %></code></pre>
        </div>
      </div>
    </section>

    <section class="finding-remediation" aria-label="Remediación del hallazgo">
      <div class="finding-section-heading"><h4>Remediación</h4><% if finding.status_fixed? && finding.scan.pull_request_url.present? %><%= external_link(safe_join(["Revisar en el PR", app_icon(:external)]), finding.scan.pull_request_url, class: "text-link") %><% end %></div>
      <% if finding.recommendation.present? %><%= simple_format(h(finding.recommendation), class: "finding-copy", sanitize: false) %><% end %>
      <% changes = finding_changes(finding) %>
      <% changes.each do |file| %>
        <div class="finding-code-frame finding-diff">
          <header><span><%= app_icon(:file) %><%= file.fetch("path") %></span><span class="finding-diff-counts"><span>+<%= file["additions"].to_i %></span><span>−<%= file["deletions"].to_i %></span></span></header>
          <div class="finding-code-scroll" tabindex="0" role="region" aria-label="Diff de <%= file.fetch('path') %>">
            <pre class="finding-source"><code><% finding_diff_rows(file.fetch('diff'), path: file.fetch('path')).each do |row| %><span class="finding-diff-line diff-<%= row[:kind] %>"><span class="finding-line-number" aria-hidden="true"><%= row[:old] %></span><span class="finding-line-number" aria-hidden="true"><%= row[:new] %></span><span class="finding-diff-marker" aria-hidden="true"><%= row[:marker] %></span><span class="finding-source-text syntax-highlight"><%= row[:html] || row[:text] %></span></span><% end %></code></pre>
          </div>
        </div>
        <% if Array(file['finding_ids']).size > 1 %><p class="finding-note">Este archivo contiene correcciones asociadas a varios hallazgos.</p><% end %>
        <% if file.fetch('diff').lines.size > FindingsHelper::DIFF_PREVIEW_LINES %><p class="finding-note">Vista previa de las primeras <%= FindingsHelper::DIFF_PREVIEW_LINES %> líneas.</p><% end %>
      <% end %>
      <% if changes.empty? %>
        <p class="finding-note"><%= finding.status_manual? ? 'Requiere intervención manual. No se ha preparado un cambio automático para este hallazgo.' : 'No hay cambios de código propuestos para este hallazgo.' %></p>
      <% elsif !finding.status_fixed? %>
        <p class="finding-note">Cambio preparado. Todavía no consta como publicado para este hallazgo.</p>
      <% end %>
    </section>

    <% if finding.verification.present? %><section class="finding-verification"><h4>Cómo comprobarlo</h4><%= simple_format(h(finding.verification), class: "finding-copy", sanitize: false) %></section><% end %>
    <% if finding.issue_url.present? %><div class="finding-review-links"><%= external_link(safe_join([app_icon(:github), "Ver issue en GitHub", app_icon(:external)]), finding.issue_url, class: "text-link") %></div><% end %>
  </div>
</details>
