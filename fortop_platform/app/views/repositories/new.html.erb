<% content_for :title, "Conectar repositorio · Fortop" %><% content_for :breadcrumb, "Conectar repositorio" %>
<%= link_to repositories_path, class: "back-link" do %><%= app_icon(:back) %> Repositorios<% end %>
<div class="page-heading">
  <div><h1>Elige un repositorio</h1><p>Conecta los repositorios a los que Fortop tiene acceso en GitHub.</p></div>
  <% if @installation %>
    <%= link_to github_installation_settings_url(@installation), class: "button button-primary", target: "_blank", rel: "noopener noreferrer" do %>
      <%= app_icon(:github) %> Añadir repositorios en GitHub <%= app_icon(:external) %>
    <% end %>
  <% end %>
</div>
<% if @installations.empty? %>
  <section class="panel empty-state compact-empty"><span class="repository-glyph large"><%= app_icon(:github) %></span><h2>Dale acceso a Fortop</h2><p>Instala la aplicación de GitHub y elige los repositorios<br class="desktop-break"> que quieres analizar. Puedes cambiarlo después.</p><%= button_to github_installation_path, class: "button button-primary", data: { turbo: false } do %><%= app_icon(:github) %> Elegir acceso en GitHub <%= app_icon(:external) %><% end %><%= link_to "Ya la he instalado. Actualizar lista", new_repository_path, class: "text-link" %></section>
<% else %>
  <section class="panel picker-panel">
    <div class="picker-access">
      <div>
        <% if @installation["repository_selection"] == "selected" %>
          <strong>Fortop solo tiene acceso a los repositorios seleccionados de <%= @installation.dig("account", "login") %>.</strong>
        <% else %>
          <strong>Repositorios autorizados de <%= @installation.dig("account", "login") %>.</strong>
        <% end %>
        <p>¿Falta alguno? Pulsa «Añadir repositorios en GitHub», selecciónalo y guarda. Después, actualiza esta lista.</p>
      </div>
      <%= link_to "Actualizar lista", new_repository_path(installation_id: @installation.fetch("id")), class: "text-link", data: { turbo: false } %>
    </div>
    <%= form_with url: new_repository_path, method: :get, class: "picker-filters" do |form| %><div class="form-field"><%= form.label :installation_id, "Cuenta de GitHub" %><%= form.select :installation_id, @installations.map { |installation| [installation.dig("account", "login"), installation.fetch("id")] }, { selected: @installation.fetch("id") }, class: "form-input" %></div><div class="form-field search-field"><%= form.label :q, "Filtrar esta página" %><div class="input-with-icon"><%= app_icon(:search) %><%= form.search_field :q, value: @query, placeholder: "Nombre del repositorio…", class: "form-input" %></div></div><%= form.submit "Buscar", class: "button button-secondary" %><% end %>
    <div class="picker-heading"><span>REPOSITORIO</span><span>ACCESO</span></div>
    <% if @github_repositories.empty? %><div class="picker-empty"><%= app_icon(:search) %><p>No hay repositorios en esta página<%= @query.present? ? " que coincidan con tu búsqueda" : "" %>.</p><% if @query.present? %><%= link_to "Quitar filtro", new_repository_path(installation_id: @installation.fetch("id"), page: @page), class: "text-link" %><% end %></div><% end %>
    <% @github_repositories.each do |repo| %><% connected = @connected_ids.include?(repo.fetch("id")); writable = repo.dig("permissions", "push") && !repo["archived"] && !repo["disabled"] %><div class="picker-row"><%= repository_language_logo(repo["language"]) %><div class="picker-repo-copy"><strong><%= repo.fetch("full_name") %></strong><% if repo["description"].present? %><p><%= repo["description"] %></p><% end %><div><span><%= repo["private"] ? 'Privado' : 'Público' %></span><% if repo["language"].present? %><span>· <%= repo["language"] %></span><% end %><% if repo["archived"] %><span>· Archivado</span><% end %></div></div><% if connected %><span class="badge badge-success"><%= app_icon(:check) %> Conectado</span><% elsif writable %><%= button_to repositories_path, params: { full_name: repo.fetch("full_name"), installation_id: @installation.fetch("id") }, class: "button button-secondary button-small" do %><%= app_icon(:plus) %> Conectar<% end %><% else %><span class="badge badge-neutral">Sin escritura</span><% end %></div><% end %>
    <div class="picker-footer"><span>Página <%= @page %><% if @query.present? %> · El filtro se aplica a esta página<% end %></span><nav class="pagination" aria-label="Páginas de repositorios"><% if @page > 1 %><%= link_to "← Anterior", new_repository_path(installation_id: @installation.fetch("id"), page: @page - 1, q: @query), class: "text-link" %><% end %><% if @has_next_page %><%= link_to "Siguiente →", new_repository_path(installation_id: @installation.fetch("id"), page: @page + 1, q: @query), class: "text-link" %><% end %></nav></div>
  </section>
  <p class="picker-help">¿El repositorio está en otra cuenta? <%= button_to "Dar acceso a otra cuenta de GitHub", github_installation_path, class: "text-link", form_class: "inline-form", data: { turbo: false } %></p>
<% end %>
