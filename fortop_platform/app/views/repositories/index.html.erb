<% content_for :title, "Repositorios · Fortop" %>
<div class="page-heading"><div><span class="eyebrow">TU PUNTO DE PARTIDA</span><h1>Repositorios</h1><p>Conecta tu código. Tus agentes se encargan del siguiente paso.</p></div><% if @repositories.any? %><%= link_to new_repository_path, class: "button button-primary" do %><%= app_icon(:plus) %> Conectar un repositorio<% end %><% end %></div>
<% if @repositories.empty? %>
  <section class="empty-state panel"><div class="empty-mark" aria-hidden="true"><%= image_tag "brand/ascenso.svg", alt: "", width: 88, height: 88 %><span class="empty-mark-plus">+</span></div><span class="eyebrow">AQUÍ EMPIEZA EL ASCENSO</span><h2>Tu primer repositorio,<br>un nuevo punto de partida.</h2><p>Conecta un repositorio de GitHub para analizar su presencia<br class="desktop-break"> en buscadores e IA y preparar mejoras en tu código.</p><%= link_to new_repository_path, class: "button button-primary" do %><%= app_icon(:plus) %> Conectar un repositorio <%= app_icon(:arrow) %><% end %><span class="empty-caption"><%= app_icon(:lock) %> Tú controlas el acceso y revisas cada pull request.</span></section>
<% else %>
  <div class="section-bar"><span><%= pluralize(@repositories.size, "repositorio conectado", "repositorios conectados") %></span><span>Tu código, organizado.</span></div>
  <div class="repository-grid"><% @repositories.each do |repository| %><%= link_to repository_path(repository), class: "repository-card panel" do %><div class="repository-card-top"><span class="repository-glyph"><%= app_icon(:repository) %></span><%= app_icon(:arrow, css_class: "card-arrow") %></div><span class="repository-owner"><%= repository.full_name.split('/').first %></span><h2><%= repository.display_name %></h2><p class="repository-description"><%= repository.description.presence || "Tu repositorio está listo para su siguiente análisis." %></p><div class="repository-card-meta"><span><%= app_icon(:branch) %><%= repository.default_branch %></span><% if repository.language.present? %><span><span class="language-dot"></span><%= repository.language %></span><% end %></div><div class="repository-card-bottom"><%= status_badge(repository.latest_scan) %><span><%= repository.private? ? 'Privado' : 'Público' %></span></div><% end %><% end %></div>
<% end %>
