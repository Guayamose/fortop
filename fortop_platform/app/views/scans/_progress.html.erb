<% phases = [["discovering", "Preparar", "Contexto y código"], ["analyzing", "Analizar", "Investigación con IA"], ["remediating", "Remediar", "Propuesta de cambios"], ["validating", "Verificar", "Comprobaciones"], ["publishing", "Publicar", "Issues y pull request"]] %>
<% phase_index = if scan.completed?
  phases.length
elsif scan.failed?
  [5, 15, 45, 78, 88].rindex { |threshold| scan.progress >= threshold } || -1
else
  phases.index { |phase| phase.first == scan.status } || -1
end %>
<section class="panel scan-status-panel <%= scan.failed? ? 'scan-has-error' : '' %>" aria-label="Estado del análisis">
  <div class="scan-status-top"><div class="scan-state-heading"><span class="scan-state-symbol <%= scan.completed? ? 'is-complete' : scan.failed? ? 'is-error' : '' %>"><% if scan.active? %><span class="state-spinner"></span><% else %><%= app_icon(scan.completed? ? :check : :alert) %><% end %></span><div><span class="eyebrow"><%= scan.completed? ? 'EJECUCIÓN FINALIZADA' : scan.failed? ? 'LA EJECUCIÓN SE HA DETENIDO' : scan.cancelled? ? 'EJECUCIÓN CANCELADA' : 'TUS AGENTES ESTÁN TRABAJANDO' %></span><h2><%= scan.completed? ? 'Análisis completado' : scan.status_label %></h2></div></div><div class="scan-duration"><%= app_icon(:clock) %><%= elapsed_time(scan) %></div></div>
  <div class="progress-label"><span><%= scan.completed? ? 'Proceso finalizado' : scan.failed? ? 'Progreso hasta la interrupción' : scan.queued? ? 'Esperando al siguiente agente disponible' : 'El progreso se actualiza automáticamente' %></span><strong><%= scan.progress %>%</strong></div>
  <div class="progress-track" role="progressbar" aria-label="Progreso del análisis" aria-valuenow="<%= scan.progress %>" aria-valuemin="0" aria-valuemax="100"><span style="width: <%= scan.progress %>%"></span></div>
  <ol class="phase-list"><% phases.each_with_index do |(status, label, detail), index| %><% state = scan.completed? || index < phase_index ? 'is-done' : scan.failed? && index == phase_index ? 'is-blocked' : status == scan.status ? 'is-current' : '' %><li class="<%= state %>"><span class="phase-number"><%= state == 'is-done' ? app_icon(:check) : state == 'is-blocked' ? app_icon(:alert) : format('%02d', index + 1) %></span><div><strong><%= label %></strong><span><%= detail %></span></div></li><% end %></ol>
  <% if scan.failed? %>
    <div class="scan-error" role="alert"><%= app_icon(:alert) %><div><strong>No se ha podido completar el análisis.</strong><p><%= scan.error_message.presence || 'Se ha producido un error durante la ejecución. Puedes volver a intentarlo.' %></p></div></div>
    <% if scan.publication_retryable? %>
      <%= button_to "Reintentar publicación", retry_publication_repository_scan_path(scan.repository, scan), class: "button button-primary button-small", data: { turbo_submits_with: "Solicitando reintento…" } %>
      <p class="quiet-note">Conserva las correcciones y reintenta GitHub sin repetir la IA.</p>
    <% else %>
      <%= button_to "Reintentar análisis", repository_scans_path(scan.repository), class: "button button-primary button-small", data: { turbo_submits_with: "Solicitando análisis…" } %>
      <p class="quiet-note">Se iniciará un nuevo análisis con IA.</p>
    <% end %>
  <% end %>
  <% if scan.cancelled? %><div class="scan-error" role="status"><%= app_icon(:alert) %><p>Este análisis se ha cancelado. Puedes iniciar una nueva ejecución desde el repositorio.</p></div><% end %>
</section>

<% if scan.completed? || scan.failed? %>
  <section class="panel results-panel">
    <div class="section-heading"><div><span class="eyebrow">RESULTADOS DE ESTA EJECUCIÓN</span><h2><%= scan.completed? ? 'Lo que hemos encontrado' : 'Resultados hasta la interrupción' %></h2></div></div>
    <% if scan.summary.present? %><p class="scan-summary"><%= scan.summary %></p><% elsif scan.failed? %><p class="scan-summary">Los resultados publicados antes del error se conservan aquí.</p><% end %>
    <div class="results-metrics"><div><span>Hallazgos</span><strong><%= scan.findings.size %></strong></div><div><span>Archivos con cambios</span><strong><%= scan.changed_files.size %></strong></div><div><span>Issues publicados</span><strong><%= scan.findings.count { |finding| finding.issue_url.present? } %></strong></div><div><span>Pull request</span><strong><%= scan.pull_request_url.present? ? '1' : '0' %></strong></div></div>
    <% if scan.pull_request_url.present? %><div class="pull-request-callout"><span class="repository-glyph"><%= app_icon(:pull_request) %></span><div><strong>Las correcciones están listas para revisión</strong><p>Revisa el diff y las comprobaciones antes de incorporar los cambios.</p></div><%= external_link(safe_join(["Ver pull request", app_icon(:external)]), scan.pull_request_url, class: "button button-primary button-small") %></div><% elsif scan.completed? %><div class="no-changes-note"><%= app_icon(:code) %><p><strong>No se ha creado un pull request.</strong> <%= scan.changed_files.empty? ? 'Esta ejecución no ha producido cambios de código validados para proponer.' : 'Consulta los hallazgos y la actividad para ver el resultado de publicación.' %></p></div><% end %>
    <% if scan.metadata.dig('coverage', 'read_files') %><p class="coverage-note">Cobertura: <%= scan.metadata.dig('coverage', 'read_files') %> archivos leídos de <%= scan.metadata.dig('coverage', 'eligible_files') || scan.metadata.dig('coverage', 'total_files') %> archivos elegibles. El diagnóstico se limita al código examinado.</p><% end %>
  </section>
<% end %>

<% if scan.findings.any? && !scan.active? %>
  <div class="section-heading"><div><span class="eyebrow">DIAGNÓSTICO CON EVIDENCIAS</span><h2>Hallazgos y oportunidades</h2></div><span><%= scan.findings.size %> <%= scan.findings.size == 1 ? 'hallazgo' : 'hallazgos' %></span></div>
  <section class="findings-list"><% scan.findings.order(:id).each do |finding| %><details class="panel finding-card"><summary><span class="severity-mark severity-<%= finding.severity %>"></span><div class="finding-heading"><strong><%= finding.title %></strong><span><%= finding.category %><% if finding.file_path.present? %><span class="inline-divider">/</span><code><%= finding.file_path %><%= ":#{finding.line_number}" if finding.line_number.present? %></code><% end %></span></div><span class="badge badge-neutral"><%= severity_label(finding.severity) %></span><span class="finding-state"><%= finding_status_label(finding.status) %></span><span class="details-toggle">+</span></summary><div class="finding-body"><p><%= finding.description %></p><% if finding.evidence.present? %><h4>Evidencia</h4><pre><%= finding.evidence %></pre><% end %><% if finding.recommendation.present? %><h4>Propuesta</h4><p><%= finding.recommendation %></p><% end %><% if finding.issue_url.present? %><%= external_link(safe_join(["Ver issue en GitHub", app_icon(:external)]), finding.issue_url, class: "text-link") %><% end %></div></details><% end %></section>
<% end %>

<div class="scan-details-grid">
  <section class="panel activity-panel"><div class="panel-heading"><h2>Actividad de los agentes</h2><% if scan.active? %><span class="live-label"><span class="status-dot"></span>En directo</span><% end %></div><div class="activity-list"><% events = scan.scan_events.order(created_at: :desc, id: :desc).limit(60).to_a %><% if events.empty? %><p class="quiet-note">La actividad aparecerá en cuanto comience la ejecución.</p><% end %><% events.each do |event| %><div class="activity-event activity-<%= event.kind %>"><span class="activity-dot"></span><div><p><%= event.message %></p><time datetime="<%= event.created_at.iso8601 %>"><%= event.created_at.in_time_zone('Europe/Madrid').strftime('%H:%M:%S') %></time></div></div><% end %></div></section>
  <div class="scan-side-panels">
    <% if scan.validation_results.any? %><section class="panel validation-panel"><div class="panel-heading"><h2>Comprobaciones</h2></div><div class="validation-list"><% scan.validation_results.each do |check| %><details class="validation-check"><summary><%= app_icon(check['passed'] ? :check : :alert) %><span><%= check['name'] %></span><span class="validation-result"><%= check['passed'] ? 'Correcto' : 'Revisar' %></span></summary><% if check['details'].present? %><pre><%= check['details'] %></pre><% end %></details><% end %></div></section><% end %>
    <% if scan.changed_files.any? %><section class="panel changed-files-panel"><div class="panel-heading"><h2>Archivos modificados</h2></div><ul><% scan.changed_files.each do |file| %><li><%= app_icon(:code) %><code><%= file['path'] %></code><span>+<%= file['additions'] || 0 %> / −<%= file['deletions'] || 0 %></span></li><% end %></ul></section><% end %>
    <section class="scan-context"><%= app_icon(:lock) %><p>Fortop propone los cambios en GitHub. Cada pull request queda pendiente de tu revisión.</p></section>
  </div>
</div>
