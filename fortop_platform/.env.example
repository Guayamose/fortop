# Fortop: copia esta plantilla a .env y rellena solo las credenciales necesarias.
APP_URL=http://localhost:3000

# Los agentes usan exclusivamente Google AI Studio.
GOOGLE_AI_STUDIO_API_KEY=
# Alternativa compatible con el nombre estándar: GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite

# 0 elimina el límite de turnos, herramientas o duración por agente.
AGENT_MAX_TURNS=0
AGENT_MAX_TOOL_CALLS=0
AGENT_TIMEOUT_SECONDS=0
# Presupuesto compartido entre análisis, resúmenes de contexto y remediación.
# 0 permite consumo sin límite de tokens; por defecto se conserva un presupuesto.
AGENT_MAX_OUTPUT_TOKENS=16384
AGENT_MAX_TOTAL_TOKENS=1000000
# Resume el historial antiguo al superar estos bytes; conserva los turnos recientes.
AGENT_CONTEXT_MAX_BYTES=120000

# Validador de JavaScript aislado. Descarga esta imagen antes de usarlo.
SCAN_NODE_IMAGE=node:24.19.0-bookworm-slim

# Registro automático en http://localhost:3000/setup/github.
# Fortop completa estas variables tras la confirmación de GitHub.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM en base64 (automático), PEM con saltos de línea o con escapes \n.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Contexto del proyecto Cloud, opcional para la API de AI Studio.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Reservadas para otros usos: los agentes de Fortop no leen estas claves.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
