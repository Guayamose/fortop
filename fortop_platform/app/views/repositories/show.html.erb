<% content_for :title, "#{@repository.display_name} · Fortop" %><% content_for :breadcrumb, @repository.display_name %>
<% content_for :body_class, "repository-page" %>
<div class="repository-profile">
<%= link_to repositories_path, class: "back-link" do %><%= app_icon(:back) %> Repositorios<% end %>
<header class="repository-heading">
  <div>
    <h1><span class="repository-owner"><%= @repository.full_name.split('/').first %> / </span><span class="repository-title-name"><%= @repository.display_name %></span></h1>
    <div class="repository-profile-meta"><span><%= app_icon(:branch) %><%= @repository.default_branch %></span><% if @repository.language.present? %><span><%= @repository.language %></span><% end %><span><%= app_icon(@repository.private? ? :lock : :globe) %><%= @repository.private? ? 'Privado' : 'Público' %></span></div>
  </div>
  <%= external_link(safe_join([app_icon(:github), "GitHub", app_icon(:external)]), @repository.html_url, class: "repository-github-link text-link") %>
</header>
<div data-controller="scan-progress" data-scan-progress-url-value="<%= repository_path(@repository, scan_id: @selected_scan&.id, follow_restart: params[:scan_id].blank? ? '1' : nil, format: :json) %>" data-scan-progress-active-value="<%= @active_scan.present? %>">
  <div class="polling-error" role="status" data-scan-progress-target="error" hidden>No se puede actualizar el progreso en este momento. Reconectando…</div>
  <div data-scan-progress-target="content"><%= render "repositories/workspace" %></div>
</div>
</div>
