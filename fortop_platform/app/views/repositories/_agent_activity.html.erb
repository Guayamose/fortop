<% events = scan.scan_events.order(created_at: :desc, id: :desc).limit(80).to_a.reverse %>
<% phase = console_phase(scan) %>
<section class="repository-console agent-activity console-tone-<%= phase[:tone] %>" id="scan-<%= scan.id %>-console" data-controller="agent-activity" data-console-state="<%= phase[:state] %>" data-action="scan-progress:before-render@document->agent-activity#beforeRender scan-progress:after-render@document->agent-activity#afterRender" aria-label="Actividad del agente">
  <header class="activity-heading">
    <h4>Actividad del agente</h4>
    <span class="repository-console-status"><span class="console-presence" aria-hidden="true"></span><%= { 'live' => 'En directo', 'waiting' => 'En espera', 'stopping' => 'Deteniendo…', 'paused' => 'En pausa', 'failed' => 'Interrumpido', 'cancelled' => 'Cancelado', 'completed' => 'Finalizado' }.fetch(phase[:state]) %></span>
  </header>
  <div class="activity-stream">
    <div class="activity-output" data-agent-activity-target="output" data-action="scroll->agent-activity#track" tabindex="0" role="log" aria-live="polite" aria-relevant="additions" aria-atomic="false" aria-label="Acciones del agente">
      <ol>
        <% events.each do |event| %>
          <% style = console_event_style(event); message = console_event_message(event); path = event.metadata['path'].to_s.presence %>
          <li class="agent-action <%= 'is-warning' if event.kind == 'warning' %>" id="scan-event-<%= event.id %>" data-agent-activity-target="event">
            <span class="agent-action-icon" title="<%= style[:label] %>"><%= app_icon(style[:icon]) %></span>
            <div>
              <p><%= message %></p>
              <% if path && !message.include?(path) %><code class="activity-file"><%= path %></code><% end %>
              <% if event.kind == 'publication' && (url = event.metadata['issue_url'].presence || event.metadata['pull_request_url'].presence) %>
                <%= external_link(safe_join(['Ver en GitHub', app_icon(:external)]), url, class: 'activity-link text-link') %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ol>
      <% if events.empty? %><p class="activity-empty">Las acciones aparecerán cuando empiece el agente.</p><% end %>
    </div>
    <button type="button" class="console-follow-button" data-agent-activity-target="latest" data-action="agent-activity#follow" hidden><%= app_icon(:arrow_down) %><span data-agent-activity-target="unread">Últimas acciones</span></button>
  </div>
</section>
