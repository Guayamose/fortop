<div class="admin-pagination">
  <span><%= admin_number(@total) %> registros · Página <%= @page %> de <%= @pages %></span>
  <div>
    <% if @page > 1 %><%= link_to "Anterior", url_for(request.query_parameters.merge(page: @page - 1)), class: "text-link" %><% end %>
    <% if @page < @pages %><%= link_to "Siguiente", url_for(request.query_parameters.merge(page: @page + 1)), class: "text-link" %><% end %>
  </div>
</div>
