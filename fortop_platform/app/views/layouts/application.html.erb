<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Fortop · Análisis y remediación GEO" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#ffffff">
    <meta name="application-name" content="Fortop">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if current_user %><meta name="turbo-cache-control" content="no-cache"><% end %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= [current_user ? 'workspace-body' : 'access-body', content_for(:body_class)].compact.join(' ') %>">
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <% if current_user %>
      <header class="topbar"><div class="topbar-inner">
        <%= link_to root_path, class: "brand-link", aria: { label: "Fortop, inicio" } do %><%= image_tag "brand/fortop-dark.svg", alt: "FORTOP", class: "topbar-logo", width: 146, height: 38 %><%= image_tag "brand/ascenso.svg", alt: "", class: "topbar-mark", width: 29, height: 26 %><% end %>
        <span class="topbar-divider" aria-hidden="true"></span>
        <span class="workspace-account"><span>@<%= current_user.login %></span></span>
        <nav class="main-nav" aria-label="Navegación principal">
          <% administration = controller_path.start_with?("admin/") %>
          <%= link_to root_path, class: "nav-item #{'is-active' if !administration && controller_name == 'home'}", aria: { current: ("page" if !administration && controller_name == "home") } do %>Inicio<% end %>
          <% repository_section = !administration && %w[repositories scans].include?(controller_name) %>
          <%= link_to repositories_path, class: "nav-item #{'is-active' if repository_section}", aria: { current: ("page" if repository_section) } do %>Repositorios<% end %>
          <% brand_section = !administration && controller_name.start_with?("brand", "visibility") %>
          <%= link_to brands_path, class: "nav-item #{'is-active' if brand_section}", aria: { label: "Visibilidad de marca", current: ("page" if brand_section) } do %><span class="nav-label-full">Visibilidad de marca</span><span class="nav-label-compact" aria-hidden="true">Marcas</span><% end %>
        </nav>
        <div class="topbar-right"><span class="topbar-github"><span class="status-dot"></span> GitHub conectado</span>
          <details class="account-menu"><summary aria-label="Menú de cuenta"><span class="account-avatar"><%= current_user.login.first.upcase %></span><%= app_icon(:chevron_down) %></summary>
            <div class="account-menu-panel"><div class="account-copy"><strong><%= current_user.display_name %></strong><span>@<%= current_user.login %></span></div>
              <% if current_user.admin? %><%= link_to admin_root_path, class: "account-menu-item" do %><%= app_icon(:shield_check) %> Administración<% end %><% end %>
              <%= link_to new_repository_path, class: "account-menu-item" do %><%= app_icon(:plus) %> Conectar repositorio<% end %>
              <%= button_to logout_path, method: :delete, class: "account-menu-item logout-button" do %><%= app_icon(:logout) %> Cerrar sesión<% end %>
            </div>
          </details>
        </div>
      </div></header>
      <div class="workspace-main">
        <main id="main-content" class="page-content" tabindex="-1">
          <%= render "shared/flash" %><%= yield %>
          <footer class="workspace-footer"><span>FORTOP</span><span>Tu código. Tu próxima mejora.</span></footer>
        </main>
      </div>
    <% else %>
      <main id="main-content" class="access-main" tabindex="-1"><%= render "shared/flash" unless controller_name == "sessions" && action_name == "new" %><%= yield %></main>
    <% end %>
  </body>
</html>
