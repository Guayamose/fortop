# Fortop: copia esta plantilla a .env y rellena solo las credenciales necesarias.
APP_URL=http://localhost:3000

# Los agentes usan exclusivamente Google AI Studio.
GOOGLE_AI_STUDIO_API_KEY=
# Alternativa compatible con el nombre estándar: GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite

# Límites de consumo. El total se comparte entre ambos agentes de un escaneo.
AGENT_MAX_TURNS=10
AGENT_MAX_TOOL_CALLS=30
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_MAX_TOTAL_TOKENS=60000

# Validador de JavaScript aislado. Descarga esta imagen antes de usarlo.
SCAN_NODE_IMAGE=node:24.19.0-bookworm-slim

# Registro automático en http://localhost:3000/setup/github.
# Fortop completa estas variables tras la confirmación de GitHub.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM en base64 (automático), PEM con saltos de línea o con escapes \n.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Contexto del proyecto Cloud, opcional para la API de AI Studio.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Reservadas para otros usos: los agentes de Fortop no leen estas claves.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
