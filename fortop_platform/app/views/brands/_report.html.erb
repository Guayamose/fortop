<% summary = @metrics.summary %>
<div class="visibility-report-layout">
  <nav class="visibility-report-nav" aria-label="Secciones del informe"><span class="visibility-eyebrow">EN ESTE ESTUDIO</span><% [["overview","Resumen"],["competition","Competencia"],["markets","Mercados e intención"],["questions","Preguntas y respuestas"],["sources","Fuentes"],["perception","Percepción"],["actions","Plan de acción"],["evolution","Evolución"],["understanding","Tu negocio"],["method","Método y costes"]].each_with_index do |(id,label),index| %><a href="#<%= id %>"><span><%= (index+1).to_s.rjust(2,'0') %></span><%= label %></a><% end %></nav>
  <div class="visibility-report-body">
    <section class="visibility-section visibility-overview" id="overview"><header><span class="visibility-eyebrow">TU VISIBILIDAD, CON EVIDENCIA</span><h2>¿Apareces cuando importa?</h2><p><%= @study.report['summary'].presence || 'Las respuestas se incorporan al informe a medida que se contrastan. Los resultados son provisionales hasta completar el estudio.' %></p></header>
      <%= form_with url: brand_path(@brand), method: :get, class: "visibility-report-filters", data: { action: "change->visibility-report#filter submit->visibility-report#filter", visibility_report_target: "filters" } do %><%= hidden_field_tag :study_id,@study.id %><label>Preguntas<%= select_tag :scope, options_for_select([["Sin marca","unbranded"],["Con marca","branded"],["Todas","all"]],@metrics.filters['scope']) %></label><label>Mercado<%= select_tag :market, options_for_select([["Todos",""]]+@study.panel.pluck('market').uniq.map { |value| [value,value] },@metrics.filters['market']) %></label><label>Etapa<%= select_tag :intent, options_for_select([["Todas",""]]+VisibilityHelper::INTENT_LABELS.map { |key,value| [value,key] },@metrics.filters['intent']) %></label><label>Tema<%= select_tag :topic, options_for_select([["Todos",""]]+@study.panel.pluck('topic').uniq.map { |value| [value,value] },@metrics.filters['topic']) %></label><label>Idioma<%= select_tag :language, options_for_select([["Todos",""]]+@study.panel.pluck('language').uniq.map { |value| [value,value] },@metrics.filters['language']) %></label><label>Fuente citada<%= select_tag :source, options_for_select([["Todas las fuentes",""]]+@source_domains.map { |value| [value,value] },@metrics.filters['source']) %></label><%= submit_tag "Aplicar", class: "button button-secondary button-small visibility-filter-submit" %><% end %>
      <div class="visibility-sample-line"><span class="visibility-engine-mark"><%= app_icon(:sparkles) %> Gemini API</span><span>Búsqueda habilitada</span><span><%= summary['valid'] %> / <%= summary['expected'] %> respuestas válidas</span><span><%= visibility_percent(summary['coverage']) %> de cobertura</span></div>
      <% if @metrics.filters['scope'] != 'unbranded' %><div class="visibility-notice"><%= app_icon(:lightbulb) %><span><%= @metrics.filters['scope'] == 'branded' ? 'Este panel pregunta expresamente por marcas. Su presencia no mide descubrimiento espontáneo.' : 'Este filtro mezcla preguntas con marca y sin marca. Usa «Sin marca» para evaluar descubrimiento.' %></span></div><% end %>
      <div class="visibility-kpis"><a href="#questions" class="visibility-primary-kpi"><%= visibility_ring(summary['presence']) %><div><strong>Presencia</strong><p><b><%= summary['present'] %></b> de <%= summary['valid'] %> respuestas mencionan tu marca.</p></div></a><div class="visibility-kpi"><%= app_icon(:check) %><span>Recomendación</span><strong><%= visibility_percent(summary['recommendation']) %></strong><small><%= summary['recommended'] %> / <%= summary['valid'] %> respuestas te recomiendan.</small></div><div class="visibility-kpi"><%= app_icon(:globe) %><span>Citación propia</span><strong><%= visibility_percent(summary['citation']) %></strong><small><% if @study.brand_brief.context['website'].present? %><%= summary['cited'] %> / <%= summary['citation_denominator'] %> respuestas con origen verificable citan tu web.<% else %>Sin sitio web indicado.<% end %></small></div></div>
      <div class="visibility-confidence"><div><%= app_icon(:shield_check) %><span>Consistencia entre repeticiones <b><%= visibility_percent(summary['stability']) %></b></span></div><p><% if summary['repeated_questions'].positive? %><%= summary['repeated_questions'] %> preguntas con al menos dos respuestas. Mide si la presencia se repite, incluso cuando la marca no aparece.<% else %>Necesitamos dos respuestas de una misma pregunta para medir la consistencia.<% end %><% if summary['round_range'] %> Presencia por ronda: <%= visibility_percent(summary['round_range'].first) %>–<%= visibility_percent(summary['round_range'].last) %>. No es un intervalo de confianza.<% end %></p></div>
      <% if summary['ambiguous'].positive? %><p class="visibility-footnote"><%= summary['ambiguous'] %> respuestas con identidad ambigua se han excluido de las métricas. No se cuentan como ausencias.</p><% end %>
      <div class="visibility-engine-scope"><span>Entorno medido <b>Gemini API</b></span><span>ChatGPT <i>Sin medir</i></span><span>Claude <i>Sin medir</i></span><span>Gemini web <i>Sin medir</i></span></div>
      <% @study.report.fetch('insights',[]).each do |insight| %><article class="visibility-insight"><%= app_icon(:lightbulb) %><div><h3><%= insight['title'] %></h3><p><%= insight['description'] %></p><div class="visibility-evidence-links"><% insight['observation_ids'].first(4).each do |id| %><%= evidence_link(id,"Respuesta ##{id}") %><% end %></div></div></article><% end %>
    </section>
    <section class="visibility-section" id="competition"><header><span class="visibility-eyebrow">01 / ENTORNO COMPETITIVO</span><h2>Quién ocupa las respuestas.</h2><p>Presencia en la muestra y cuota de menciones entre las marcas investigadas. No representa cuota de mercado.</p></header>
      <% if @metrics.valid.empty? %><p class="visibility-empty-note">Los competidores aparecerán aquí cuando haya respuestas contrastadas.</p><% else %><div class="visibility-ranking-label"><span>Marca</span><span>Presencia</span><span>Cuota del panel</span></div><% @metrics.ranking.each_with_index do |entity,index| %><div class="visibility-ranking-row <%= 'is-brand' if entity['key']=='brand' %>"><div class="visibility-ranking-identity"><small><%= (index+1).to_s.rjust(2,'0') %></small><div><strong><%= entity['name'] %><%= ' · Tú' if entity['key']=='brand' %></strong><span><%= entity['domain'] || Visibility::Urls.domain(entity['website']) %></span></div></div><div class="visibility-ranking-bar"><div><span style="width:<%= entity['presence'].to_f.clamp(0,100) %>%"></span></div><b><%= visibility_percent(entity['presence']) %></b><small><%= entity['count'] %> respuestas</small></div><strong class="visibility-ranking-share"><%= visibility_percent(entity['share']) %></strong></div><% end %><% end %>
      <details class="visibility-details" id="competitor-research"><summary><%= app_icon(:search) %> Por qué investigamos estas marcas <%= app_icon(:chevron_down) %></summary><% if @study.competitors.empty? %><p>No se han encontrado competidores con fuentes suficientes. Puedes ampliar el contexto en el brief.</p><% end %><% @study.competitors.each do |competitor| %><article class="visibility-competitor-note"><div><strong><%= visibility_link(competitor['name'],competitor['website']) %></strong><span class="visibility-tag"><%= { 'direct'=>'Directo','alternative'=>'Alternativa','reference'=>'Referencia' }[competitor['kind']] %></span></div><p><%= competitor['reason'] %></p><small><%= Array(competitor['markets']).join(' · ') %></small><div><% (competitor['sources'] || competitor['source_indexes'].map { |index| @study.research_sources[index] }).compact.each_with_index do |source,index| %><%= visibility_link("[#{index+1}] #{source['title'].to_s.truncate(80)}",source['canonical_url'].presence || source['url']) %><% end %></div></article><% end %></details>
    </section>
    <section class="visibility-section" id="markets"><header><span class="visibility-eyebrow">02 / DÓNDE Y CUÁNDO</span><h2>Cada mercado, cada intención.</h2><p>Presencia por contexto geográfico y etapa de búsqueda. Cada celda muestra su muestra real.</p></header><div class="visibility-heatmap" role="table" aria-label="Presencia por mercado y etapa"><div class="visibility-heatmap-row visibility-heatmap-header" role="row"><span role="columnheader">Mercado</span><% VisibilityHelper::INTENT_LABELS.each_value do |label| %><span role="columnheader"><%= label %></span><% end %></div><% @metrics.heatmap.each do |market| %><div class="visibility-heatmap-row" role="row"><strong role="rowheader"><%= market['name'] %></strong><% market['cells'].each do |cell| %><div role="cell" class="visibility-heat-cell <%= cell['presence'].nil? ? 'is-empty' : "intensity-#{(cell['presence']/25).floor.clamp(0,4)}" %>"><strong><%= visibility_percent(cell['presence']) %></strong><small><%= cell['valid'] %> respuestas</small></div><% end %></div><% end %></div><p class="visibility-footnote">Es un mapa de presencia por intención; no mide conversiones del embudo ni la ubicación del usuario.</p></section>
    <section class="visibility-section" id="questions"><header><span class="visibility-eyebrow">03 / EL DETALLE QUE LO EXPLICA</span><h2>Preguntas reales. Respuestas abiertas.</h2><p>Abre cada respuesta para revisar el texto original, sus citas y la evidencia que sustenta la clasificación.</p></header><% if @metrics.questions.empty? %><p class="visibility-empty-note">No hay preguntas para esta combinación de filtros.</p><% end %><div class="visibility-question-list"><% @metrics.question_rows.each_with_index do |question,index| %><details class="visibility-question" id="question-<%= question['key'] %>"><summary><span class="visibility-question-index"><%= (index+1).to_s.rjust(2,'0') %></span><div><strong><%= question['text'] %></strong><div class="visibility-question-meta"><span><%= question['market'] %> · <%= question['language'] %></span><span><%= VisibilityHelper::INTENT_LABELS[question['intent']] %></span><span><%= question['topic'] %></span><% if question['branded'] %><span class="visibility-branded-tag">Con marca</span><% end %></div></div><span class="visibility-question-score"><b><%= visibility_percent(question['presence']) %></b><small><%= question['present'] %>/<%= question['valid'] %></small></span><%= app_icon(:chevron_down) %></summary><div class="visibility-question-detail"><p><b>Audiencia:</b> <%= question['audience'] %></p><% if question['competitors'].any? %><p><b>También aparecen:</b> <%= question['competitors'].join(', ') %></p><% end %><div class="visibility-answer-list"><% question['observations'].each do |observation| %><div><span>Repetición <%= observation.repetition %></span><span class="visibility-tag"><%= { 'queued'=>'Pendiente','answered'=>'Contrastando','completed'=>'Analizada','failed'=>'Fallida' }[observation.status] %></span><% if %w[answered completed].include?(observation.status) %><%= evidence_link(observation.id) %><% end %></div><% end %></div></div></details><% end %></div></section>
    <section class="visibility-section" id="sources"><header><span class="visibility-eyebrow">04 / DE DÓNDE SALEN LAS RESPUESTAS</span><h2>Las fuentes que están influyendo.</h2><p>Páginas citadas en las respuestas, su frecuencia y las marcas que aparecen en esas mismas respuestas. La coincidencia no demuestra causalidad.</p></header><% sources=@metrics.sources %><% if sources.empty? %><p class="visibility-empty-note">Todavía no hay citas verificables en esta muestra. No inventaremos fuentes para completar el gráfico.</p><% end %><div class="visibility-source-list"><% sources.first(30).each do |source| %><article class="visibility-source-row"><span class="visibility-source-icon"><%= app_icon(:globe) %></span><div><strong><%= visibility_link(source['title'].presence || source['domain'].presence || 'Fuente de Google', source['canonical_url'].presence || source['url']) %></strong><small><%= source['resolved'] ? source['domain'] : 'Origen pendiente de resolver · enlace de Google' %></small><p><%= source['brands'].join(' · ') %></p><div class="visibility-evidence-links"><% source['observation_ids'].first(3).each do |id| %><%= evidence_link(id,"##{id}") %><% end %></div></div><div class="visibility-source-frequency"><strong><%= source['count'] %></strong><small>respuestas</small><span style="width:<%= sources.first['count'].positive? ? 70.0*source['count']/sources.first['count'] : 0 %>px"></span></div></article><% end %></div><% if sources.size>30 %><p class="visibility-footnote">Mostrando 30 de <%= sources.size %> páginas. Todas las citas siguen disponibles en cada respuesta.</p><% end %></section>
    <section class="visibility-section" id="perception"><header><span class="visibility-eyebrow">05 / CÓMO TE DESCRIBEN</span><h2>Lo que las respuestas dicen de ti.</h2><p>Atributos extraídos de citas literales. Describen esta muestra de respuestas, no la opinión de todo el mercado.</p></header><% if @metrics.traits.empty? %><p class="visibility-empty-note">Aún no hay atributos con una cita literal que identifique a tu marca.</p><% end %><div class="visibility-traits"><% @metrics.traits.each do |trait| %><details class="visibility-trait"><summary><strong><%= trait['label'] %></strong><span><%= trait['count'] %> respuestas</span><%= app_icon(:chevron_down) %></summary><% trait['evidence'].first(5).each do |item| %><blockquote><%= item['quote'] %><%= evidence_link(item['observation_id']) %></blockquote><% end %></details><% end %></div><% if @metrics.claims.any? %><h3 class="visibility-subheading">Afirmaciones que conviene revisar</h3><p class="visibility-footnote">Posibles discrepancias frente a la investigación. Requieren revisión; no se clasifican como errores demostrados.</p><% @metrics.claims.first(12).each do |claim| %><article class="visibility-claim"><blockquote><%= claim['quote'] %></blockquote><p><%= claim['explanation'] %></p><div class="visibility-evidence-links"><%= evidence_link(claim['observation_id']) %><% claim['source_indexes'].each do |index| %><% source=@study.research_sources[index] %><%= visibility_link("Fuente [#{index+1}]",source['canonical_url'].presence || source['url']) if source %><% end %></div></article><% end %><% end %></section>
    <section class="visibility-section" id="actions"><header><span class="visibility-eyebrow">06 / DEL DIAGNÓSTICO A LA MEJORA</span><h2>Tu siguiente movimiento.</h2><p>Acciones priorizadas y vinculadas a respuestas. Las comprobaciones técnicas pueden continuar en un repositorio conectado.</p></header><% actions=@study.visibility_actions.order(Arel.sql("CASE priority WHEN 'high' THEN 0 WHEN 'medium' THEN 1 ELSE 2 END"),:id) %><% if actions.empty? %><p class="visibility-empty-note">El diagnóstico preparará las acciones cuando haya evidencia suficiente.</p><% end %><% actions.each_with_index do |action,index| %><article class="visibility-action" id="visibility-action-<%= action.id %>"><div class="visibility-action-number"><%= (index+1).to_s.rjust(2,'0') %></div><div class="visibility-action-content"><div class="visibility-action-labels"><span class="visibility-priority priority-<%= action.priority %>">Prioridad <%= severity_label(action.priority).downcase %></span><span><%= {'technical'=>'Comprobación técnica','editorial'=>'Contenido','positioning'=>'Posicionamiento'}[action.kind] %></span><span>Esfuerzo <%= severity_label(action.effort).downcase %></span></div><h3><%= action.title %></h3><p><%= action.description %></p><div class="visibility-evidence-links"><% action.observation_ids.first(5).each do |id| %><%= evidence_link(id,"Respuesta ##{id}") %><% end %></div><div class="visibility-action-controls"><%= form_with model: action,url: brand_visibility_study_action_path(@brand,@study,action) do |form| %><%= form.label :status,"Estado",class: "sr-only" %><%= form.select :status, VisibilityHelper::ACTION_LABELS.map { |key,label| [label,key] } %><%= form.submit "Guardar",class: "button button-secondary button-small" %><% end %><% if action.scan %><%= link_to "Ver análisis del repositorio →",repository_path(action.scan.repository,scan_id: action.scan.id),class: "text-link" %><% elsif action.kind=='technical' && @repositories.any? %><%= form_with url: handoff_brand_visibility_study_action_path(@brand,@study,action) do %><%= label_tag "repo-#{action.id}","Repositorio",class: "sr-only" %><%= select_tag :repository_id, options_from_collection_for_select(@repositories,:id,:full_name),id: "repo-#{action.id}" %><%= button_tag "Analizar en repositorio",class: "button button-secondary button-small" %><% end %><% end %></div></div></article><% end %></section>
    <section class="visibility-section" id="evolution"><header><span class="visibility-eyebrow">07 / MEDIR OTRA VEZ, COMPARAR MEJOR</span><h2>Una historia que se puede seguir.</h2><p>Solo comparamos estudios completos con las mismas preguntas, competidores, modelo y método.</p></header><% history=@metrics.comparable_history %><% if history.size>=2 %><%= visibility_trend(history) %><div class="visibility-trend-legend"><% history.each do |entry| %><%= link_to "##{entry['id']} · #{human_timestamp(entry['date'])}",brand_path(@brand,study_id: entry['id']),class: "text-link" %><% end %></div><% else %><div class="visibility-evolution-empty"><%= app_icon(:branch) %><div><strong><%= history.one? ? 'Tu primera referencia ya está guardada.' : 'Aquí crecerá tu evolución.' %></strong><p>Repite el estudio reutilizando el panel. Cuando haya dos mediciones completas y comparables aparecerá la gráfica.</p></div></div><% end %></section>
    <%= render "profile" %>
    <section class="visibility-section" id="method"><header><span class="visibility-eyebrow">08 / TRANSPARENCIA</span><h2>Qué hemos medido. Y cómo.</h2></header><dl class="visibility-method-list"><div><dt>Entorno y modelo</dt><dd><%= @study.settings['engine'] %> · <%= @study.settings['model'] %>. No reproduce la interfaz de los productos de consumo.</dd></div><div><dt>Diseño de la muestra</dt><dd><%= @study.panel.size %> preguntas × <%= @study.settings['repetitions'] %> repeticiones previstas. Panel generado para este negocio, sin volumen de búsqueda observado.</dd></div><div><dt>Geografías</dt><dd><%= @study.settings['geography'] %></dd></div><div><dt>Diagnóstico cualitativo</dt><dd>Las estadísticas usan toda la muestra válida. Las recomendaciones se apoyan en <%= @study.report['diagnosis_sample_size'] || 0 %> respuestas de una selección de hasta 80, repartidas entre mercados y etapas; cada acción conserva sus evidencias.</dd></div><div><dt>Identidad y evidencia</dt><dd>Las menciones y atributos requieren citas literales. Las identidades ambiguas se excluyen. Las respuestas fallidas o pendientes no cuentan como ausencia.</dd></div><div><dt>Fuentes</dt><dd>Solo los enlaces asociados por Google a un fragmento de respuesta cuentan como citas. Los dominios sin resolver se excluyen del denominador de citación propia.</dd></div><div><dt>Comparación competitiva</dt><dd>La cuota divide las menciones de cada marca entre las menciones del panel investigado. Pueden aparecer varias marcas por respuesta. No es cuota de mercado.<% if @study.settings['panel_source_id'] %> El panel y la selección competitiva proceden del estudio #<%= @study.settings['panel_source_id'] %>; se conservan sus fuentes originales para mantener la comparación.<% end %></dd></div><div><dt>Coste estimado</dt><dd><b><%= visibility_usd(@study.spent_usd) %></b> de <%= visibility_usd(@study.budget_usd) %> · <%= @study.request_count %> solicitudes · <%= number_with_delimiter(@study.token_count) %> tokens · <%= @study.search_count %> consultas de búsqueda devueltas.</dd></div><div><dt>Control de gasto</dt><dd>Reserva conservadora antes de cada solicitud. Las solicitudes fallidas o de respuesta incierta conservan su reserva. Google no permite fijar un máximo de búsquedas por solicitud; esta estimación no sustituye su facturación.</dd></div><div><dt>Método y tarifas</dt><dd><%= @study.settings['method_version'] %> · tarifas consultadas el <%= @study.settings['pricing_checked_at'] %> · <%= visibility_link('Precios de Google',@study.settings['pricing_source']) %>.</dd></div></dl><details class="visibility-details" id="study-brief"><summary><%= app_icon(:file) %> Brief original de este estudio <%= app_icon(:chevron_down) %></summary><div class="visibility-original-text"><%= @study.brand_brief.content %></div><%= render "brands/source_documents", documents: @study.brand_brief.documents %></details><details class="visibility-details" id="study-research"><summary><%= app_icon(:globe) %> Investigación web guardada <%= app_icon(:chevron_down) %></summary><div class="visibility-original-text"><%= @study.research %></div><% @study.research_sources.each_with_index do |source,index| %><p><%= visibility_link("[#{index+1}] #{source['title']}",source['canonical_url'].presence || source['url']) %></p><% end %><% @study.visibility_calls.where(grounded:true,status:'succeeded').where("task_key = ? OR task_key LIKE ?",'research','research:market:%').select(:id,:task_key,:search_entry_point).each do |research_call| %><%= visibility_search_widget(research_call.search_entry_point) %><% end %></details></section>
  </div>
</div>
