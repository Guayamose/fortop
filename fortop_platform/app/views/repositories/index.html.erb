<% content_for :title, "Repositorios · Fortop" %>
<div class="page-heading">
  <div><h1>Repositorios</h1><p>Tu código, sus análisis y las mejoras que están por llegar.</p></div>
  <% if @repositories.any? %><%= link_to new_repository_path, class: "button button-secondary" do %><%= app_icon(:plus) %> Conectar un repositorio<% end %><% end %>
</div>
<% if @repositories.empty? %>
  <section class="empty-state">
    <div class="empty-connection" aria-hidden="true"><span><%= app_icon(:github) %></span><i></i><span><%= image_tag "brand/ascenso.svg", alt: "", width: 39, height: 36 %></span></div>
    <h2>Tu primer repositorio.<br>El principio de algo mejor.</h2>
    <p>Conecta tu código con Fortop. Tus agentes encontrarán oportunidades<br class="desktop-break"> y prepararán las mejoras para que puedas revisarlas.</p>
    <%= link_to new_repository_path, class: "button button-primary" do %><%= app_icon(:plus) %> Conectar un repositorio <%= app_icon(:arrow) %><% end %>
    <span class="empty-caption"><%= app_icon(:lock) %> Tú eliges el acceso y apruebas cada cambio.</span>
  </section>
<% else %>
  <%= render "browser" %>
<% end %>
