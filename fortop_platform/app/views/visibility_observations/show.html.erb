<turbo-frame id="visibility-evidence">
  <article class="visibility-observation"><div class="visibility-inline-meta"><span>Estudio #<%= @study.id %></span><span>Repetición <%= @observation.repetition %></span><span><%= @observation.question['market'] %> · <%= @observation.question['language'] %></span></div><h2><%= @observation.question['text'] %></h2><p class="visibility-footnote"><%= @observation.model_version.presence || 'Modelo pendiente' %> · <%= human_timestamp(@observation.observed_at) %> · Búsqueda habilitada</p><h3>Respuesta original</h3><div class="visibility-original-text visibility-answer-text"><%= @observation.answer.presence || 'Todavía no hay respuesta guardada.' %></div>
    <% @observation.analysis.fetch('mentions',[]).each do |mention| %><% entity=@study.entities.find { |item| item['key']==mention['entity_key'] } %><div class="visibility-observed-mention"><h3><%= mention['name'].presence || entity&.fetch('name') %><span class="visibility-tag"><%= mention['certainty']=='confirmed' ? 'Identidad confirmada' : 'Identidad ambigua · excluida' %></span></h3><blockquote><%= mention['quote'] %></blockquote><% if mention['identity_reason'].present? %><p><b>Identidad:</b> <%= mention['identity_reason'] %></p><% end %><p><%= mention['recommended'] ? 'Recomendación identificada en esta respuesta.' : 'Mención sin recomendación explícita verificada.' %> Tono: <%= {'positive'=>'positivo','neutral'=>'neutro','negative'=>'negativo','mixed'=>'mixto'}[mention['sentiment']] %>.</p><% if mention['recommendation_quote'] %><blockquote><%= mention['recommendation_quote'] %></blockquote><% end %></div><% end %>
    <% if @observation.status=='completed' && @observation.analysis.fetch('mentions',[]).empty? %><p class="visibility-notice">No se han verificado menciones de las marcas del panel en esta respuesta.</p><% end %>
    <% if @observation.analysis['brand_reason'].present? %><p class="visibility-notice"><b>Evaluación de tu marca:</b> <%= @observation.analysis['brand_reason'] %></p><% end %>
    <h3>Fuentes devueltas por Google</h3><% if @observation.citations.empty? %><p class="visibility-footnote">Google no devolvió fuentes para esta respuesta.</p><% end %><ol class="visibility-observation-sources"><% @observation.citations.each do |source| %><li><%= visibility_link(source['title'].presence || 'Fuente',source['canonical_url'].presence || source['url']) %><small><%= source['domain'].presence || 'Origen pendiente de resolver' %> · <%= source['cited'] ? 'Citada en la respuesta' : 'Recuperada, sin fragmento de cita verificado' %></small><% Array(source['excerpts']).first(3).each do |quote| %><blockquote><%= quote %></blockquote><% end %></li><% end %></ol><%= visibility_search_widget(@call&.search_entry_point) %>
    <% if @call %><details class="visibility-details"><summary>Solicitud y trazabilidad <%= app_icon(:chevron_down) %></summary><dl class="visibility-method-list"><div><dt>Pregunta exacta enviada</dt><dd class="visibility-original-text"><%= @call.input_prompt %></dd></div><div><dt>Instrucción del entorno</dt><dd class="visibility-original-text"><%= @call.system_instruction %></dd></div><div><dt>Configuración</dt><dd>Temperatura <%= @call.request_settings['temperature'] %> · máximo <%= @call.request_settings['max_output_tokens'] %> tokens de salida.</dd></div><div><dt>Consultas devueltas</dt><dd><%= @call.search_queries.join(' · ').presence || 'No se devolvieron consultas de búsqueda.' %></dd></div><div><dt>Consumo estimado</dt><dd><%= visibility_usd(@call.cost_usd) %> · <%= @call.usage['total_tokens'] %> tokens. No es un dato de factura.</dd></div></dl></details><% end %>
  </article>
</turbo-frame>
