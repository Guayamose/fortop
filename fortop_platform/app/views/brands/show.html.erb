<% content_for :title, "#{@brand.name} · Visibilidad · Fortop" %>
<div class="visibility-page" data-controller="visibility-report" data-visibility-report-url-value="<%= brand_path(@brand, study_id: @study&.id, follow_restart: @study&.active? ? '1' : nil, format: :json) %>" data-visibility-report-active-value="<%= @study&.work_pending? || false %>">
  <%= link_to brands_path, class: "back-link" do %><%= app_icon(:back) %> Marcas<% end %>
  <header class="brand-profile-heading"><div class="brand-profile-identity"><span class="brand-monogram large"><%= @brand.name.first.upcase %></span><div><span class="visibility-eyebrow">INTELIGENCIA DE MARCA</span><h1><%= @brand.name %></h1><div class="visibility-inline-meta"><% if @brand.website.present? %><%= visibility_link(Visibility::Urls.domain(@brand.website), @brand.website) %><span>·</span><% end %><%= @brand.markets.pluck('name').join(' / ') %></div></div></div><%= link_to edit_brand_path(@brand), class: "button button-secondary" do %><%= app_icon(:edit) %> Editar brief<% end %></header>
  <div class="polling-error" data-visibility-report-target="error" role="status" hidden>No se puede actualizar el estudio. Reconectando… Los resultados guardados siguen disponibles.</div>
  <div data-visibility-report-target="content"><%= render "workspace" %></div>
  <dialog class="visibility-dialog" data-visibility-report-target="dialog" data-action="click->visibility-report#backdrop"><header><span class="visibility-eyebrow">EVIDENCIA / RESPUESTA ORIGINAL</span><button type="button" class="console-icon-button" aria-label="Cerrar evidencia" data-action="visibility-report#closeEvidence">✕</button></header><turbo-frame id="visibility-evidence" data-visibility-report-target="evidence"><p>Cargando respuesta…</p></turbo-frame></dialog>
</div>
