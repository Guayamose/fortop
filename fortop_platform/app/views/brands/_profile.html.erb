<section class="visibility-section" id="understanding"><header><span class="visibility-eyebrow">CONTEXTO / BRIEF V<%= @study.brand_brief.version %></span><h2>Así entendemos tu negocio.</h2><p>Interpretación del brief, contrastada con la investigación. Las hipótesis siguen siendo hipótesis.</p></header><div class="visibility-context-grid"><div><h3>Negocio y propuesta de valor</h3><p><%= @study.profile['business'] %></p><p><%= @study.profile['value_proposition'] %></p></div><div><h3>Público y necesidades</h3><div class="visibility-tags"><% Array(@study.profile['audiences']).each do |audience| %><span><%= audience %></span><% end %></div><ul class="visibility-simple-list"><% Array(@study.profile['needs']).each do |need| %><li><%= need %></li><% end %></ul></div></div>
  <% if @study.profile['assumptions'].present? %><details class="visibility-details" id="brand-assumptions"><summary><%= app_icon(:lightbulb) %> Hipótesis y datos pendientes <%= app_icon(:chevron_down) %></summary><ul class="visibility-simple-list"><% @study.profile['assumptions'].each do |item| %><li><%= item %></li><% end %></ul></details><% end %>
  <% if @study.profile['facts'].present? %><details class="visibility-details" id="brand-facts"><summary><%= app_icon(:shield_check) %> Hechos documentados <%= app_icon(:chevron_down) %></summary><% @study.profile['facts'].each do |fact| %><p><%= fact['claim'] %> <% Array(fact['source_indexes']).each do |index| %><% source=@study.research_sources[index] %><%= visibility_link("[#{index+1}]", source['canonical_url'].presence || source['url']) if source %><% end %></p><% end %></details><% end %>
  <p class="visibility-footnote">¿No refleja tu negocio? <%= link_to "Corregir el brief", edit_brand_path(@brand), class: "text-link" %>. Se guardará una nueva versión para los próximos estudios.</p>
</section>
